{
  "name": "@gideon/mcp-generator",
  "version": "0.1.0",
  "description": "Standalone OpenAPI 3.0+ to MCP generator. Audit, config-driven build, and compile OpenAPI specs to MCP servers.",
  "type": "module",
  "bin": {
    "mcp-generator": "dist/cli.js",
    "mcp-gen": "dist/bin/mcp-generator.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "audit": "node --import tsx src/cli.ts audit",
    "audit:check-drift": "node --import tsx scripts/check-audit-drift.ts",
    "dev": "node --import tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
